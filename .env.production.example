# Preparation template only. Copy values into the selected platform's secret
# manager; do not commit a populated production environment file.
NODE_ENV=production

# Choose exactly one provider. Leave its key unset for an offline-demo-only
# deployment smoke test, then add the key through the platform dashboard.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Alternative provider:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# The platform should inject PORT. Use 3000 only for a local production smoke.
PORT=3000

# Keep these within the bounds enforced by server/config.ts.
AI_REQUEST_TIMEOUT_MS=45000
ANALYSIS_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000

# No database, persistent disk, authentication secret, or client-side API key
# is required by the current application.
