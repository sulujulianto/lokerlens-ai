# Templat persiapan saja. Salin nilai ke pengelola nilai rahasia milik platform yang
# dipilih; jangan sertakan berkas lingkungan produksi berisi nilai nyata dalam commit.
NODE_ENV=production

# Pilih tepat satu penyedia. Biarkan kunci API kosong untuk pengujian awal penerapan
# yang hanya memakai demo luring, lalu tambahkan kunci melalui dasbor platform.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Penyedia alternatif:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Platform seharusnya menyediakan PORT. Gunakan 3000 hanya untuk pengujian awal
# produksi lokal.
PORT=3000

# Pertahankan nilai berikut dalam batas yang diterapkan server/config.ts.
AI_REQUEST_TIMEOUT_MS=45000
ANALYSIS_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000

# Aplikasi saat ini tidak memerlukan basis data, disk persisten, nilai rahasia
# autentikasi, atau kunci API pada sisi klien.
