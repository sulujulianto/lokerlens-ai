AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Alternative provider (choose one AI_PROVIDER value at a time):
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5.6-luna
# Maximum time to wait for one provider response (milliseconds).
AI_REQUEST_TIMEOUT_MS=45000
# Limit each client to this many analysis requests per window.
ANALYSIS_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000
# PORT=3000
