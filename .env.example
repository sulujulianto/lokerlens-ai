AI_PROVIDER=gemini
GEMINI_API_KEY=masukkan_kunci_api_gemini_di_sini
GEMINI_MODEL=gemini-3.5-flash
# Penyedia alternatif (pilih satu nilai AI_PROVIDER pada satu waktu):
# AI_PROVIDER=openai
# OPENAI_API_KEY=masukkan_kunci_api_openai_di_sini
# OPENAI_MODEL=gpt-5.6-luna
# Waktu tunggu maksimum untuk satu respons penyedia (milidetik).
AI_REQUEST_TIMEOUT_MS=45000
# Batasi setiap klien sebanyak nilai ini untuk setiap jendela waktu analisis.
ANALYSIS_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000
# PORT=3000
